PORT=3000
MONGO_URI=mongodb://localhost:27017/smartqueue
REDIS_URL=redis://localhost:6379
NO_SHOW_GRACE_SECONDS=180
NEAR_THRESHOLD=3
# Active notification channels (default: inapp,log). To enable Web Push, add 'push':
# NOTIFY_CHANNELS=inapp,push,log (requires VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT)
NOTIFY_CHANNELS=inapp,log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartqueue.local
JOBS_ENABLED=true
TIMEZONE=Asia/Kolkata
JWT_SECRET=replace_with_a_secret_key_at_least_32_characters_long
OTP_CODE=123456
STAFF_OTP_CODE=
CLIENT_ORIGIN=http://localhost:5173
