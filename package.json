{
  "name": "smartqueue-root",
  "version": "1.0.0",
  "private": true,
  "description": "SmartQueue root workspace script proxy",
  "scripts": {
    "test": "npm --prefix server test && npm --prefix client test",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "dev": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed --",
    "smoke": "npm --prefix server run smoke --",
    "watch": "npm --prefix server run watch --",
    "vapid": "npm --prefix server run vapid",
    "qr": "npm --prefix server run qr --",
    "sim": "npm --prefix server run sim --",
    "sim:db": "npm --prefix server run sim:db --",
    "bench": "node bench/index.js",
    "bench:table": "node bench/table.js"
  }
}
